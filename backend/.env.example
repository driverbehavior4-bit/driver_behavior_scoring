SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Type: mongodb (default) or sqlite or mysql
DATABASE_TYPE=mongodb

# MongoDB Settings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=driver_safety

# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# SQL Settings (if DATABASE_TYPE=sqlite or mysql)
DATABASE_URL=sqlite:///./driver_safety.db
# DATABASE_URL=mysql+pymysql://fleet_user:strong_password@localhost:3306/driver_safety
